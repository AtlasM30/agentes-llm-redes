# Configuracao de Ambiente — Etapa 7 (Agente LLM + RAG + Validador Deterministico)
# Copie este arquivo para .env e preencha apenas o provedor desejado.
# O arquivo .env real ja esta ignorado no .gitignore.

# Provedor padrao: simulado | gemini | openai | groq | ollama
LLM_PROVEDOR=simulado

# Nome do modelo (opcional; usa padrao do provedor quando omitido)
# Exemplos: gemini-2.5-flash | gpt-4o-mini | llama-3.3-70b-versatile | llama3.1:8b
LLM_MODELO=

# Hiperparametros recomendados para reprodutibilidade experimental
LLM_TEMPERATURA=0.0
RAG_TOP_K=4
POLITICA_SEGURANCA=padrao

# --- Google Gemini API ---
GEMINI_API_KEY=

# --- OpenAI / Groq / Servidor Compativel ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Ollama (local ou no host da VM VirtualBox) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
